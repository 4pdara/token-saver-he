{
  "manifest_version": 3,
  "name": "token-saver-he",
  "version": "4.0.2",
  "description": "תרגום הודעות מעברית לאנגלית לפני שליחה באתרי צ׳אט, עם בועה נגררת להפעלה ולכיבוי.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Token Saver HE",
    "default_icon": {
      "16": "assets/brand/icon-16.png",
      "32": "assets/brand/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/brand/icon-16.png",
    "32": "assets/brand/icon-32.png",
    "48": "assets/brand/icon-48.png",
    "128": "assets/brand/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
